{
  "name": "opencam-pc-studio",
  "version": "1.6.5",
  "description": "Ultra high-performance native Windows PC Client for OpenCam Android Camera",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test_stream_parser.js && node test_vcam.js",
    "build": "electron-builder --win portable"
  },
  "keywords": [
    "webcam",
    "android",
    "streaming",
    "mjpeg",
    "h264",
    "obs",
    "opencam"
  ],
  "author": "OpenCam Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.opencam.studio",
    "productName": "OpenCam Studio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
